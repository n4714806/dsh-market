{
  "name": "@dsh-market/plugin",
  "version": "0.4.17-portable.5",
  "description": "非官方繁體中文外掛市場：原生安裝管理、可見更新與一鍵更新、任務追蹤、全域預設模型。",
  "type": "module",
  "main": "lib/index-tracked.js",
  "exports": {
    ".": {
      "default": "./lib/index-tracked.js"
    },
    "./invariant": {
      "default": "./lib/invariant.js"
    },
    "./client": {
      "default": "./lib/client-tasks.js"
    },
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/native-install-progress.js",
    "lib/profile-runtime.js",
    "lib/invariant.js",
    "lib/semantic-model.js",
    "lib/managed-inventory.js",
    "lib/managed-mutations.js",
    "cordis.patch.yml",
    "test-universal.mjs",
    "test-default-model.mjs",
    "test-polling.mjs",
    "test-managed-inventory.mjs",
    "test-managed-mutations.mjs",
    "test-ui-feedback.mjs",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale/en.json",
    "locale/zh.json",
    "locale/zh-TW.json",
    "lib/index-tracked.js",
    "lib/client-tasks.js",
    "lib/install-task-store.js",
    "lib/subagent-tracked.js",
    "lib/source-versions.js",
    "lib/managed-source-updates.js",
    "test-task-backend.mjs",
    "test-task-ui.mjs",
    "test-source-versions.mjs",
    "test-source-integration.mjs",
    "lib/client-build-info.js",
    "test-client-build.mjs",
    "test-update-capability.mjs",
    "test-installed-updates.mjs",
    "lib/client-optimized-v2.js",
    "lib/zh-tw-data.js",
    "lib/zh-tw-presentation.js",
    "scripts/build-zh-tw.py",
    "scripts/build-zh-tw-client.mjs",
    "licenses/OPENCC-LICENSE.txt",
    "licenses/OPENCC-NOTICE.txt",
    "THIRD-PARTY-NOTICES.md",
    "test-zh-tw-ui.mjs",
    "lib/update-operation.js",
    "lib/update-version-check.js",
    "test-update-version-check.mjs",
    "test-update-outcome-ui.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test-universal.mjs && node test-default-model.mjs && node test-polling.mjs && node test-managed-inventory.mjs && node test-managed-mutations.mjs && node test-ui-feedback.mjs && node --test test-task-backend.mjs test-task-ui.mjs test-source-versions.mjs && node test-source-integration.mjs && node test-client-build.mjs && node --test test-update-capability.mjs test-installed-updates.mjs && node --test test-zh-tw-ui.mjs && node --test test-update-version-check.mjs test-update-outcome-ui.mjs",
    "build:zh-tw": "node scripts/build-zh-tw-client.mjs"
  },
  "dependencies": {
    "@dsh-market/core": "0.4.15",
    "@dsh-market/schema": "0.1.4"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "market",
    "cordis"
  ],
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n4714806/dsh-market.git"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0",
    "node": ">=20.3.0"
  }
}
