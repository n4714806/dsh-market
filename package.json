{
  "name": "@dsh-market/plugin",
  "version": "0.4.17-portable.1",
  "description": "非官方可攜式插件市場修正版：原生安裝管理、精確已裝辨識、全域預設模型與明確狀態。",
  "type": "module",
  "main": "lib/index-optimized-v2.js",
  "exports": {
    ".": {
      "default": "./lib/index-optimized-v2.js"
    },
    "./invariant": {
      "default": "./lib/invariant.js"
    },
    "./client": {
      "default": "./lib/client-optimized-v2.js"
    },
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index-optimized-v2.js",
    "lib/native-install-progress.js",
    "lib/profile-runtime.js",
    "lib/client-optimized-v2.js",
    "lib/invariant.js",
    "lib/subagent-compat.js",
    "lib/semantic-model.js",
    "lib/managed-inventory.js",
    "lib/managed-mutations.js",
    "cordis.patch.yml",
    "test-universal.mjs",
    "test-default-model.mjs",
    "test-polling.mjs",
    "test-managed-inventory.mjs",
    "test-managed-mutations.mjs",
    "test-ui-feedback.mjs",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale/en.json",
    "locale/zh.json",
    "locale/zh-TW.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test-universal.mjs && node test-default-model.mjs && node test-polling.mjs && node test-managed-inventory.mjs && node test-managed-mutations.mjs && node test-ui-feedback.mjs"
  },
  "dependencies": {
    "@dsh-market/core": "0.4.15",
    "@dsh-market/schema": "0.1.4"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "market",
    "cordis"
  ],
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n4714806/dsh-market.git"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0",
    "node": ">=20"
  }
}
